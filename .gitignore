node_modules
dist
.vite

# vue/src/auto-imports.d.ts and vue/src/components.d.ts are generated by
# unplugin-auto-import and unplugin-vue-components, and they are committed:
# `pnpm type-check` reads them, also on a fresh clone with no build.

# Go build/test artifacts
/bin/
/lora
*.test
*.exe
*.exe~
*.dll
*.so
*.dylib
*.out
*.prof
coverage.*
!**/coverage.go
*.coverprofile
go.work
go.work.sum

# local config files: task init copies them from *.default.yml
/config/*.yml
!/config/*.default.yml

# local env files
.env
.env.local
.env.*.local

# local docker settings
docker-compose.override.yml

# Log files
npm-debug.log*
pnpm-debug.log*

# MCP config
.mcp.json

# Repo-local Claude Code skills and output styles are tracked; everything else
# under .claude/ stays ignored.
!/.claude/
/.claude/*
!/.claude/skills
!/.claude/output-styles

# Editor directories and files
.DS_Store
.idea
.vscode
*.suo
*.sw?
*~
