{
  "name": "lora-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "component-tags": "node scripts/component-tags.ts"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@vueuse/core": "14.4.0",
    "axios": "^1.20.0",
    "vue": "3.5.43",
    "vue-i18n": "^11.4.23",
    "vue-router": "5.3.1",
    "vuetify": "4.2.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "jiti": "^2.6.1",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^9.0.3",
    "playwright": "^1.65.1",
    "prettier": "3.9.8",
    "sass": "1.105.0",
    "typescript": "~6.0.3",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11",
    "vue-tsc": "3.3.11"
